<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <Version>0.2.0</Version>
    <Title>Forth Wall Attenna</Title>
    <Description>Antenna gateway with dedicated hub status displays.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../ForthWall.Transport/ForthWall.Transport.csproj" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="Sandbox.Common"><HintPath>$(GameBin)/Sandbox.Common.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Sandbox.Game"><HintPath>$(GameBin)/Sandbox.Game.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="VRage"><HintPath>$(GameBin)/VRage.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="VRage.Game"><HintPath>$(GameBin)/VRage.Game.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="VRage.Library"><HintPath>$(GameBin)/VRage.Library.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="VRage.Math"><HintPath>$(GameBin)/VRage.Math.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="VRage.Scripting"><HintPath>$(GameBin)/VRage.Scripting.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="VRage.Render"><HintPath>$(GameBin)/VRage.Render.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="CheckGameReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(GameBin)/Sandbox.Game.dll')" Text="Set SPACE_ENGINEERS_BIN64 or -p:GameBin to the installed game's Bin64 directory." />
  </Target>
</Project>
